# Content-Security-Policy: scripts only from this site (and Cloudflare Turnstile, the public
# form's bot check), data only from this site and Supabase. Inline styles stay allowed (the page
# and React set them); inline scripts don't (index.html loads /theme-init.js instead).
# blob: is for the PDF preview, flyer previews and the PDF.js worker.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self' data:; connect-src 'self' blob: data: https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; frame-src 'self' blob: https://challenges.cloudflare.com; object-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# HTML - no cache, always revalidate
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/html; charset=utf-8

# JavaScript - aggressive caching with immutable
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

# Module workers (pdf.js, used to turn PDF flyers into images)
/assets/*.mjs
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

# CSS - aggressive caching with immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css; charset=utf-8

# Images - long-term caching
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/png

/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/jpeg

/assets/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/jpeg

/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp

/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml

/assets/*.ico
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/x-icon

# Fonts - long-term caching
/assets/*.woff
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/woff

/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/woff2

/fonts/*.woff2
  Cache-Control: public, max-age=31536000
  Content-Type: font/woff2

/fonts/*.ttf
  Cache-Control: public, max-age=31536000
  Content-Type: font/ttf

# JSON files
/*.json
  Cache-Control: no-cache
  Content-Type: application/json; charset=utf-8

# Service Worker - never cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# WASM files
/assets/*.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm

# Manifest
/manifest.json
  Cache-Control: no-cache
  Content-Type: application/manifest+json; charset=utf-8
